NODE_ENV=development
PORT=3000
TZ=Asia/Bangkok

JWT_SECRET=replace-with-your-own-local-secret
JWT_EXPIRES_IN=900

MYSQL_ROOT_PASSWORD=change_me
MYSQL_DATABASE=hotel_booking
MYSQL_PORT=3306
REDIS_PORT=6379

DATABASE_URL="mysql://root:change_me@localhost:3306/hotel_booking"
REDIS_URL="redis://localhost:6379"

# Optional: local Admin creation only. Set these in your own .env.
ADMIN_NAME="Development Admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""

# Local defaults. Production requires redis; see deploy/production.env.example.
RATE_LIMIT_STORAGE=memory
RATE_LIMIT_PREFIX=hotel-booking:development:rate-limit
# false, loopback, or a comma-separated list of actual proxy IPs/CIDRs.
TRUST_PROXY=false
