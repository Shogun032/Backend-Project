generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid()) @db.VarChar(36)
  name         String   @db.VarChar(100)
  email        String   @unique @db.VarChar(254)
  passwordHash String   @db.VarChar(255)
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  bookings     Booking[]

  @@map("users")
}

model Room {
  id            String      @id @default(uuid()) @db.VarChar(36)
  name          String      @db.VarChar(100)
  description   String      @default("") @db.VarChar(2000)
  capacity      Int
  pricePerNight Decimal     @db.Decimal(10, 2)
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  images        RoomImage[]
  bookings      Booking[]

  @@map("rooms")
}

model RoomImage {
  id        String @id @default(uuid()) @db.VarChar(36)
  roomId    String @db.VarChar(36)
  url       String @db.VarChar(500)
  altText   String @default("") @db.VarChar(200)
  sortOrder Int    @default(0)
  room      Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@map("room_images")
}

enum Role {
  USER
  ADMIN
}
model Booking {
  id            String        @id @default(uuid()) @db.VarChar(36)
  userId        String        @db.VarChar(36)
  roomId        String        @db.VarChar(36)
  checkIn       DateTime      @db.Date
  checkOut      DateTime      @db.Date
  guests        Int
  status        BookingStatus @default(PENDING)
  nights        Int
  pricePerNight Decimal       @db.Decimal(10, 2)
  totalPrice    Decimal       @db.Decimal(10, 2)
  currency      String        @default("THB") @db.VarChar(3)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user          User          @relation(fields: [userId], references: [id])
  room          Room          @relation(fields: [roomId], references: [id])
  notifications Notification[]

  @@index([userId])
  @@index([roomId, checkIn, checkOut])
  @@index([status])
  @@map("bookings")
}

enum BookingStatus {
  PENDING
  APPROVED
  CANCELLED
  PAID
}

model Notification {
  id        String   @id @default(uuid()) @db.VarChar(36)
  bookingId String   @db.VarChar(36)
  type      String   @db.VarChar(50)
  message   String   @db.VarChar(500)
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("notifications")
}
