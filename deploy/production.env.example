# Template only. Supply real values through the deployment platform / --env-file.
# This template intentionally fails validation until all secrets are replaced.
NODE_ENV=production
PORT=3000
TZ=Asia/Bangkok

# Generate a fresh random secret (at least 32 bytes); same secret on all API instances.
JWT_SECRET=
JWT_EXPIRES_IN=900

# Service names are examples. URL-encode credentials containing special characters.
DATABASE_URL=mysql://hotel_app:CHANGE_ME@mysql:3306/hotel_booking
REDIS_URL=redis://:CHANGE_ME@redis:6379/0

RATE_LIMIT_STORAGE=redis
# Must be identical on all instances; use another prefix for staging/testing.
RATE_LIMIT_PREFIX=hotel-booking:production:rate-limit
# Keep false until actual proxy addresses are known. Never use true or a hop count.
TRUST_PROXY=false
